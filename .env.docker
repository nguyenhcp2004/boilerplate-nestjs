##== Environment
NODE_ENV=development
MODULES_SET=monolith

##== Application
APP_NAME="NestJS Boilerplate API"
APP_URL=http://localhost:3000
APP_PORT=3000
APP_DEBUG=true
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,https://example.com

##== Observability (SigNoz / OpenTelemetry)
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_SERVICE_NAME=nestjs-boilerplate-api

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_boilerplate
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

##== Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
REDIS_TLS_ENABLED=false

##== Mailer
MAIL_PROVIDER=smtp
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=No Reply
MAIL_CLIENT_PORT=1080

##== Resend (only used when MAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com

##== Authentication (Better Auth)
BETTER_AUTH_SECRET=please-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_GOOGLE_CLIENT_ID=http://localhost:3000/auth/v1/login/google
AUTH_GOOGLE_CLIENT_SECRET=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
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
